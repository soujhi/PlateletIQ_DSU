# ── PlateletIQ backend configuration ─────────────────────────────────────────
# Copy to .env and fill in. Nothing here has a working default in production:
# the app starts without them but says so on /api/v1/health.

APP_ENV=development

# ── Secrets ──────────────────────────────────────────────────────────────────
# Both MUST be set and MUST stay stable across restarts. Without them the app
# generates a random per-process value, which invalidates every session and
# every outstanding OTP on restart.
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
OTP_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite is fine for a single machine. For a two-laptop setup BOTH laptops must
# point at ONE backend, so this only needs changing for a real deployment.
# DATABASE_URL=postgresql://user:password@host:5432/plateletiq
DATABASE_URL=sqlite:///./plateletiq.db

# ── Browser origins allowed to call this API ─────────────────────────────────
# Add the LAN address the second laptop loads the UI from.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Or match a whole private range at once (regex, not a glob):
# ALLOWED_ORIGIN_REGEX=http://192\.168\.1\.\d{1,3}:5173

# ── Google sign-in ───────────────────────────────────────────────────────────
# From https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID,
# type "Web application"). Add both the redirect URI below as an authorised
# redirect URI, and FRONTEND_URL as an authorised JavaScript origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Passwordless local sign-in, for testing without Google credentials.
# Leave unset (or 0) anywhere real.
ALLOW_DEV_SIGNIN=0

# ── Courier: Shiprocket ──────────────────────────────────────────────────────
# TRANSPORT_MODE=live plus credentials books real shipments. Anything else
# simulates the courier; the UI and /health both say which is in effect.
TRANSPORT_MODE=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# The pickup location nickname configured in your Shiprocket account.
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_BILLING_EMAIL=
# Shared secret for POST /api/v1/webhooks/shiprocket. Webhook intake is
# refused entirely while this is unset.
SHIPROCKET_WEBHOOK_TOKEN=

# ── Routing ──────────────────────────────────────────────────────────────────
# With a Mapbox token, routes are traffic-aware. Without one the public OSRM
# server is used, which needs no key. If both are unreachable the app falls
# back to a straight-line estimate and labels it as such in the UI.
MAPBOX_ACCESS_TOKEN=
OSRM_BASE_URL=https://router.project-osrm.org

# ── Facility coordinates ─────────────────────────────────────────────────────
# 1 geocodes each facility address through OpenStreetMap Nominatim on first
# seed (~1 request/second, so first startup takes ~20s). Otherwise the curated
# coordinates in services/facility_registry.py are used.
GEOCODE_FACILITIES=0

# ── OTP policy ───────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=1800
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=8
